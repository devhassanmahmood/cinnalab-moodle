{
  "name": "Moodle LMS",
  "description": "Moodle Learning Management System with S3 file storage",
  "repository": "https://github.com/devhassanmahmood/cinnalab-moodle.git",
  "logo": "https://moodle.org/theme/image.php/boost/theme/1609458390/moodlelogo",
  "keywords": [
    "moodle",
    "lms",
    "education",
    "php",
    "postgresql"
  ],
  "env": {
    "MOODLE_SITE_URL": {
      "description": "Your Moodle site URL (e.g., https://your-app.herokuapp.com)",
      "value": "https://cinnalab-moodle-d1962611ca61.herokuapp.com"
    },
    "DATABASE_URL": {
      "description": "PostgreSQL database URL from Heroku Postgres addon",
      "required": true
    },
    "AWS_ACCESS_KEY_ID": {
      "description": "AWS Access Key ID for S3 file storage",
      "required": true
    },
    "AWS_SECRET_ACCESS_KEY": {
      "description": "AWS Secret Access Key for S3 file storage",
      "required": true
    },
    "AWS_DEFAULT_REGION": {
      "description": "AWS region for S3 bucket (e.g., us-east-1, eu-west-1)",
      "value": "us-east-1"
    },
    "AWS_S3_BUCKET": {
      "description": "S3 bucket name for file storage",
      "required": true
    },
    "MOODLE_DEBUG": {
      "description": "Enable debug mode (true/false)",
      "value": "false"
    },
    "MOODLE_DEBUG_DISPLAY": {
      "description": "Display debug information (true/false)",
      "value": "false"
    },
    "MOODLE_DEBUG_PAGEINFO": {
      "description": "Display page info in debug mode (true/false)",
      "value": "false"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:mini"
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/php"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "scripts": {
    "postdeploy": "php admin/cli/install_database.php --agree-license --adminpass=admin123 --adminemail=hassanmahmood9912@gmail.com --fullname=Admin --shortname=admin"
  }
}